<Window x:Class="ExpertCar.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="汽修賺錢專家" Height="800" Width="1220"
        MinHeight="650" MinWidth="980" FontSize="19" Background="#F7F9FC" Foreground="#16243A">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="42"/></Style>
        <Style TargetType="TextBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Margin" Value="4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="DatePicker"><Setter Property="MinHeight" Value="38"/><Setter Property="Margin" Value="4"/></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Margin" Value="4"/></Style>
        <Style TargetType="DataGrid"><Setter Property="Margin" Value="4"/><Setter Property="RowHeight" Value="42"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/></Style>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,4,12">
            <TextBlock Text="汽修賺錢專家" FontWeight="Bold" FontSize="26"/>
            <TextBlock x:Name="StatusText" Margin="24,0" Foreground="#34506D"/>
        </StackPanel>
        <TabControl x:Name="MainTabs" KeyboardNavigation.TabNavigation="Continue">
            <TabItem Header="首頁提醒">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="提醒未來天數"/>
                        <TextBox x:Name="DaysBox" Width="75" Text="30"/>
                        <Button Content="更新名單" Click="RefreshReminders_Click"/>
                        <Button Content="標籤／通知函列印（B06）" Click="PrintPlaceholder_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="日期與里程分開顯示；里程須有目前公里數才會判定到期。缺日期車輛另列。" Margin="6" Foreground="#34506D"/>
                    <DataGrid x:Name="RemindersGrid" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="選取" Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="分組" Binding="{Binding Group}" Width="90"/><DataGridTextColumn Header="客戶" Binding="{Binding Customer}" Width="150"/>
                            <DataGridTextColumn Header="車牌" Binding="{Binding Plate}" Width="130"/><DataGridTextColumn Header="項目" Binding="{Binding Kind}" Width="90"/>
                            <DataGridTextColumn Header="日期到期" Binding="{Binding DateStatus}" Width="190"/><DataGridTextColumn Header="里程到期" Binding="{Binding MileageStatus}" Width="210"/>
                            <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="客戶／車輛">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox x:Name="SearchBox" Width="250" ToolTip="姓名、電話或車牌" KeyDown="SearchBox_KeyDown"/><Button Content="搜尋" Click="Search_Click"/></StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><Button Content="新增客戶" Click="NewCustomer_Click"/><Button Content="編輯選取客戶" Click="EditCustomer_Click"/></StackPanel>
                        <DataGrid x:Name="CustomersGrid" AutoGenerateColumns="False" SelectionChanged="CustomersGrid_SelectionChanged">
                            <DataGrid.Columns><DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="電話" Binding="{Binding Phone}" Width="150"/><DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="180"/></DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Text="車輛資料" FontWeight="Bold" FontSize="19" Margin="4,10"/>
                            <WrapPanel><TextBlock Text="車牌" Width="90"/><TextBox x:Name="PlateBox" Width="160"/><TextBlock Text="車型" Width="70"/><TextBox x:Name="ModelBox" Width="180"/></WrapPanel>
                            <WrapPanel><TextBlock Text="目前公里" Width="90"/><TextBox x:Name="OdometerBox" Width="160"/><TextBlock Text="保養公里" Width="90"/><TextBox x:Name="MaintenanceKmBox" Width="160"/></WrapPanel>
                            <WrapPanel><TextBlock Text="保養日期" Width="90"/><DatePicker x:Name="MaintenanceDatePicker" Width="160"/><TextBlock Text="驗車日期" Width="90"/><DatePicker x:Name="InspectionDatePicker" Width="160"/></WrapPanel>
                            <WrapPanel><Button Content="新增車輛" Click="NewVehicle_Click"/><Button Content="儲存車輛" Click="SaveVehicle_Click"/></WrapPanel>
                            <TextBlock Text="歷次工單（B05 完成後顯示）" Margin="4,8" Foreground="#34506D"/>
                            <DataGrid Height="65" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="日期" Width="130"/><DataGridTextColumn Header="工單號" Width="160"/><DataGridTextColumn Header="狀態" Width="130"/></DataGrid.Columns></DataGrid>
                        </StackPanel>
                        <DataGrid x:Name="VehiclesGrid" AutoGenerateColumns="False" SelectionChanged="VehiclesGrid_SelectionChanged">
                            <DataGrid.Columns><DataGridTextColumn Header="車牌" Binding="{Binding Plate}" Width="130"/><DataGridTextColumn Header="車型" Binding="{Binding Model}" Width="140"/><DataGridTextColumn Header="保養日" Binding="{Binding MaintenanceDate}" Width="120"/><DataGridTextColumn Header="保養公里" Binding="{Binding MaintenanceKm}" Width="120"/><DataGridTextColumn Header="驗車日" Binding="{Binding InspectionDate}" Width="120"/></DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="項目／零件目錄">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Bottom">
                        <WrapPanel><TextBlock Text="類別" Width="70"/><ComboBox x:Name="CatalogKindBox" Width="100"><ComboBoxItem Content="項目" IsSelected="True"/><ComboBoxItem Content="零件"/></ComboBox>
                            <TextBlock Text="代碼" Width="60"/><TextBox x:Name="CatalogCodeBox" Width="130"/><TextBlock Text="名稱" Width="60"/><TextBox x:Name="CatalogNameBox" Width="200"/></WrapPanel>
                        <WrapPanel><TextBlock Text="單位" Width="70"/><TextBox x:Name="CatalogUnitBox" Width="100"/><TextBlock Text="預設價格（元）" Width="140"/><TextBox x:Name="CatalogPriceBox" Width="140"/><TextBlock Text="現金價、未稅" Foreground="#34506D"/></WrapPanel>
                        <WrapPanel><Button Content="新增項目／零件" Click="NewCatalog_Click"/><Button Content="儲存目錄" Click="SaveCatalog_Click"/></WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="CatalogGrid" AutoGenerateColumns="False" SelectionChanged="CatalogGrid_SelectionChanged">
                        <DataGrid.Columns><DataGridTextColumn Header="類別" Binding="{Binding Kind}" Width="100"/><DataGridTextColumn Header="代碼" Binding="{Binding Code}" Width="150"/><DataGridTextColumn Header="名稱" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="單位" Binding="{Binding Unit}" Width="100"/><DataGridTextColumn Header="價格（元）" Binding="{Binding Price}" Width="120"/></DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="舊資料匯入">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="可匯入 SuperCar 資料" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="SuperCar 為其權利人之商標，本軟體與其無任何關係" Margin="0,6,0,16"/>
                        <WrapPanel><TextBlock Text="1. 來源資料夾" Width="150"/><TextBox x:Name="SourceFolderBox" Width="550" IsReadOnly="True"/><Button Content="選擇資料夾" Click="ChooseFolder_Click"/></WrapPanel>
                        <WrapPanel><Button Content="2. 掃描並演練" Click="PreviewImport_Click"/><TextBlock x:Name="ImportSummaryText" Margin="12,0" Text="尚未演練"/></WrapPanel>
                        <TextBlock Text="3. 檢查成功／跳過／待處理／失敗及下列問題；匯入前會備份目前資料庫。" Margin="4,12"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom"><WrapPanel><Button x:Name="BackupImportButton" Content="4. 備份目前資料" Click="BackupImport_Click" IsEnabled="False"/><Button x:Name="CommitImportButton" Content="5. 確認匯入" Click="CommitImport_Click" IsEnabled="False"/><Button Content="6. 核對首頁與客戶清單" Click="VerifyImport_Click"/></WrapPanel><TextBlock x:Name="ImportResultText" Margin="4,8" TextWrapping="Wrap"/></StackPanel>
                    <DataGrid x:Name="ImportProblemsGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="檔案" Binding="{Binding File}" Width="200"/><DataGridTextColumn Header="資料表" Binding="{Binding Table}" Width="160"/><DataGridTextColumn Header="列" Binding="{Binding Row}" Width="90"/><DataGridTextColumn Header="問題" Binding="{Binding Description}" Width="*"/></DataGrid.Columns></DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="店家設定">
                <StackPanel Margin="24" Width="560" HorizontalAlignment="Left">
                    <TextBlock Text="店名"/><TextBox x:Name="ShopNameBox"/>
                    <TextBlock Text="聯絡方式"/><TextBox x:Name="ShopContactBox"/>
                    <TextBlock Text="提醒天數"/><TextBox x:Name="ShopDaysBox"/>
                    <TextBlock Text="刷卡手續費 %"/><TextBox x:Name="CardFeeBox"/>
                    <TextBlock Text="營業稅率 %"/><TextBox x:Name="TaxBox"/>
                    <WrapPanel><Button Content="儲存設定" Click="SaveSettings_Click"/><Button Content="開啟監理服務網" Click="OpenMvdis_Click"/></WrapPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
