CREATE TABLE `PreSCarFix`
 (
	`估價單號`			varchar (50), 
	`零件代號`			varchar (50), 
	`零件名稱`			varchar (50), 
	`數量`			varchar (50), 
	`單價`			varchar (50), 
	`總計`			varchar (50), 
	`單位`			varchar (50)
);

