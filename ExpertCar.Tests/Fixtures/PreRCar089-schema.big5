CREATE TABLE `PreRCarFix`
 (
	`估價單號`			varchar (50), 
	`車牌號碼`			varchar (50), 
	`估價日期`			varchar (50), 
	`總計`			varchar (50), 
	`估價金額`			varchar (50)
);

